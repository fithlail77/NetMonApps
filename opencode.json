{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\09.Programming\\Laravel\\NetMonApps"
      ],
      "enabled": true
    },

    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },

    "postgres": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "{env:POSTGRES_MCP_URL}"
      ],
      "enabled": true
    },

    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_READ_ONLY",
        "-e",
        "GITHUB_TOOLSETS",
        "ghcr.io/github/github-mcp-server"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PAT}",
        "GITHUB_READ_ONLY": "1",
        "GITHUB_TOOLSETS": "repos,issues,pull_requests"
      },
      "enabled": true
    }
  },

  "permission": {
    "filesystem_*": "ask",
    "postgres_*": "ask",
    "github_*": "ask"
  }
}